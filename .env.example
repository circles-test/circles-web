# Copy to .env.local and fill in.

# Content source: "sanity" or "local" (files in src/content).
# If omitted: sanity when a project id is set, local otherwise.
CONTENT_SOURCE=sanity

# Sanity project (sanity.io/manage → circles-house). Not secret.
NEXT_PUBLIC_SANITY_PROJECT_ID=gidjsnzm
NEXT_PUBLIC_SANITY_DATASET=production

# Secret shared with the Sanity webhook that refreshes the site on publish (any long random string).
SANITY_REVALIDATE_SECRET=

# Only for `npm run seed`: token with Editor rights (sanity.io/manage → API → Tokens). Never commit it.
SANITY_WRITE_TOKEN=
